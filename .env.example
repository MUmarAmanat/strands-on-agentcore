ENVIRONMENT=dev
SOURCE_TYPE=google_sheets

# Google Sheets (required when SOURCE_TYPE=google_sheets)
GOOGLE_SHEET_ID=your_sheet_id_here
GOOGLE_SHEET_RANGE=Active!A1:Z1000
SHEET_SECRET_NAME=google-sheet-service-account-v2

# Notion (required when SOURCE_TYPE=notion)
# NOTION_DATABASE_ID=your_database_id_here
# NOTION_SECRET_NAME=reminder-agent/notion-api-key

# Amazon Bedrock model ID (auth via IAM, no API key).
# Use first-party Amazon models; third-party models are billed via Marketplace.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
SES_SENDER=you@yourdomain.com
SES_RECIPIENT=you@example.com
AWS_REGION=your-aws-region
LLM_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# IANA timezone that decides "today" (e.g. Asia/Dubai).
TIMEZONE=UTC

# AgentCore Memory ID. On AWS, Terraform sets it automatically.
# Leave empty locally = no duplicate-send check.
MEMORY_ID=

# Bedrock Guardrail ID and version. On AWS, Terraform sets them.
# Set both or neither. Empty locally = no guardrail.
GUARDRAIL_ID=
GUARDRAIL_VERSION=
